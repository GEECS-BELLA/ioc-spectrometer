# JETI SPECFIRM spectrometer boards (Thorlabs CCT series): the areaDetector
# driver's records (ADSpecfirm).
# Macros: P (device prefix), R (driver, e.g. SPEC1:), PORT, TIMEOUT, ADDR (0),
#         NELM (the most pixels this IOC takes: MAX_PIXELS)
#
# ADBase supplies Acquire, ImageMode, NumImages, TriggerMode (Internal /
# External), AcquireTime (the integration time, s), NumExposures (the board's
# averages), AcquirePeriod, DetectorState, the identity and the array
# counters. The output records take their initial values from the driver,
# which reads them from the board: nothing is written at start. The
# vendor-neutral names at the device root are ADSpecfirm_spectrometer.template.

include "ADBase.template"

# The integration time in s: the driver clamps to the board's range
# (*CONF:MINTIN? to 65 s) and AcquireTime_RBV shows what a frame used.
record(ao, "$(P)$(R)AcquireTime")
{
    field(DESC, "Integration time")
    field(EGU,  "s")
    field(PREC, "5")
    field(DRVL, "0.00001")
    field(DRVH, "65")
}
record(ai, "$(P)$(R)AcquireTime_RBV")
{
    field(EGU,  "s")
    field(PREC, "5")
}

# The board's averages per spectrum (1..10000)
record(longout, "$(P)$(R)NumExposures")
{
    field(DESC, "Averages per spectrum")
    field(DRVL, "1")
    field(DRVH, "10000")
}

record(bi, "$(P)$(R)Connected_RBV")
{
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))SPECFIRM_CONNECTED")
    field(SCAN, "I/O Intr")
    field(ZNAM, "Disconnected")
    field(ZSV,  "MAJOR")
    field(ONAM, "Connected")
}

record(waveform, "$(P)$(R)LastError_RBV")
{
    field(DTYP, "asynOctetRead")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))SPECFIRM_LAST_ERROR")
    field(SCAN, "I/O Intr")
    field(FTVL, "CHAR")
    field(NELM, "256")
}

