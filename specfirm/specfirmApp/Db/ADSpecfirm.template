# Temperature, the shutter motor's state and the board's error word, every
# 10 s while idle (the driver skips the read during an exposure): ADBase's
# own ReadStatus, given a scan
record(bo, "$(P)$(R)ReadStatus")
{
    field(SCAN, "10 second")
}
